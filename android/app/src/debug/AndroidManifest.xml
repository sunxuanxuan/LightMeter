<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application android:usesCleartextTraffic="true">
        <activity
            android:name=".paymentmonitor.PaymentMonitorActivity"
            android:exported="false"
            android:label="@string/payment_monitor_name"
            android:screenOrientation="portrait" />

        <service
            android:name=".paymentmonitor.AlipayNotificationListener"
            android:exported="true"
            android:label="@string/payment_monitor_service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".paymentmonitor.PaymentConfirmationPollingService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Internal debug payment confirmation polling" />
        </service>
    </application>

</manifest>
