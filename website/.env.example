# Local preview works without these values and uses isolated development keys.
SITE_DATA_DIR=./data
PRODUCT_PRICE_MINOR=990
PRODUCT_CURRENCY=CNY

# Production public origin. Required for proxy-safe request validation.
APP_BASE_URL=https://your-domain.example

# Personal Alipay collection-code MVP.
PAYMENT_PROVIDER=personal_alipay_monitor
PERSONAL_ALIPAY_QR_IMAGE_PATH=./asset/20260816-195133.jpeg
PERSONAL_PAYMENT_LIFETIME_SECONDS=900
PERSONAL_PAYMENT_GRACE_SECONDS=120
PERSONAL_PAYMENT_MAX_ORDERS_PER_MINUTE=5
PERSONAL_PAYMENT_MAX_ACTIVE_ORDERS_PER_BUYER=2
PAYMENT_MONITOR_ID=
PAYMENT_MONITOR_SECRET=

# The installer generates and persists these values when they are empty.
DATA_ENCRYPTION_KEY_BASE64=
LOOKUP_HMAC_PEPPER=

# Production must provide the existing activation signing key.
ACTIVATION_PRIVATE_KEY_BASE64=
ACTIVATION_SIGNING_KEY_ID=

# Official Alipay alternative. Set PAYMENT_PROVIDER=alipay to enable.
# Use \n for line breaks in PEM values.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_KEY_TYPE=PKCS8
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# Optional override. Defaults to APP_BASE_URL/api/payments/alipay/notify.
ALIPAY_NOTIFY_URL=

# Optional local artifact override.
ANDROID_APK_PATH="../android/app/build/outputs/apk/release/Click & Click.apk"
