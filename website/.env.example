# Local preview works without these values and uses isolated development keys.
SITE_DATA_DIR=./data
PRODUCT_PRICE_MINOR=990
PRODUCT_CURRENCY=CNY

# Production must provide independent secrets.
DATA_ENCRYPTION_KEY_BASE64=
LOOKUP_HMAC_PEPPER=
ACTIVATION_PRIVATE_KEY_BASE64=
ACTIVATION_SIGNING_KEY_ID=

# Alipay face-to-face payment. Use \n for line breaks in PEM values.
APP_BASE_URL=https://your-domain.example
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_KEY_TYPE=PKCS8
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# Optional override. Defaults to APP_BASE_URL/api/payments/alipay/notify.
ALIPAY_NOTIFY_URL=

# Optional local artifact override.
ANDROID_APK_PATH=../android/app/build/outputs/apk/release/app-release.apk
